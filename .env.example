# Copy to .env and edit. .env is gitignored; this file is committed.

# OpenAI-compatible endpoint. llama-server (see README) serves /v1 on port 8080.
LLM_BASE_URL=http://127.0.0.1:8080/v1
# llama-server ignores this (it has one model loaded); cloud providers need it.
LLM_MODEL=gemma-4-e2b
# llama-server doesn't check keys, but the openai library requires one.
LLM_API_KEY=sk-no-key-needed
